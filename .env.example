# MDMesh deployment config. Copy to .env (or let ./setup.sh generate it) and fill in.
# .env is gitignored — it holds secrets. Generated secrets should be alphanumeric.

# --- Database (not published to the host) ---
DB_NAME=mdmesh
DB_USER=mdmesh
# REQUIRED. Generate, e.g.: openssl rand -hex 24
DB_PASSWORD=

# --- Server ---
# REQUIRED. Public base URL devices + the console use (no trailing slash). This is also embedded in
# the enrollment QR so agents know where to reach. e.g. https://mdm.example.com  or  https://mdm.acme.dev
BASE_URL=
# REQUIRED. Shared signing secret. Generate, e.g.: openssl rand -hex 24
HASH_SECRET=
# Optional. Signs the JWTs of REST API clients (/rest/public/jwt/login). Leave empty: the server generates a key once
# and keeps it in its data volume (/opt/mdmesh/jwt.secret), so those clients stay signed in across restarts. Set it
# only to pin a key of your own: hex, a multiple of 4 characters, at least 128, e.g. openssl rand -hex 64
# (anything else is refused at start; the JWT library would silently drop characters). The server gets it as
# JWT_SECRET.
SERVER_JWT_SECRET=
# Legacy Headwind launcher setting. The MDMesh agent ignores it; leave it at 0.
SECURE_ENROLLMENT=0
# Optional extra JVM options for the server, e.g. -Xmx1g
#SERVER_JAVA_OPTS=

# --- Edge (Caddy) ---
# own-domain  → SITE_ADDRESS=mdm.example.com  (Caddy gets a Let's Encrypt cert; set ACME_EMAIL)
# cloudflare  → SITE_ADDRESS=:80              (Cloudflare terminates TLS)
SITE_ADDRESS=:80
ACME_EMAIL=

# --- Cloudflare Tunnel (only the cloudflare profile) ---
# Create a tunnel in Cloudflare Zero Trust, route its public hostname to http://caddy:80, and paste
# the tunnel token here. Then: docker compose --profile cloudflare up -d
TUNNEL_TOKEN=

# --- Auto-update (updater/recovery supervisor) ---
# The GitHub repo to poll for releases (owner/name), the channel, and this deployment's current
# version (set to the deployed release tag; 0.0.0 means "any release shows as available").
GITHUB_REPO=
UPDATE_CHANNEL=stable
POLL_INTERVAL_HOURS=6
CURRENT_VERSION=0.0.0
# Optional GitHub token to raise the API rate limit / read a private repo.
GITHUB_TOKEN=
# 1 = apply verified releases unattended (also a toggle in Settings).
#AUTO_UPDATE=0

# --- Images (./setup.sh writes these; see DEPLOY.md) ---
# GHCR owner (lowercase) the images are pulled from; "local" = images built from this checkout.
#IMAGE_OWNER=mdmesh-app
# Running image tags, without the "v" (0.3.2, not v0.3.2). Bumped on each update.
#SERVER_VERSION=latest
#WEB_VERSION=latest
# The updater's own tag. Updates never change it; "latest" keeps "docker compose pull" delivering its fixes.
#SUPERVISOR_VERSION=latest
# 1 = one-click Update in the console, 0 = show the manual steps instead.
#APPLY_SUPPORTED=1

# --- Compose (./setup.sh writes these; the updater uses them to restart the same stack) ---
#COMPOSE_PROJECT_NAME=mdmesh
# own-domain: docker-compose.yml:docker-compose.domain.yml   cloudflare: docker-compose.yml
#COMPOSE_FILE=docker-compose.yml
# cloudflare: cloudflare   own-domain: (empty)
#COMPOSE_PROFILES=

# --- SMTP (optional; password-recovery emails) ---
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=mdm@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
