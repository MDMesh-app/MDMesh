    android:width="18dp"
    android:height="20dp"
    android:viewportWidth="12"
    android:viewportHeight="13.3333">
    <group
        android:translateX="-2"
        android:translateY="-1.6667">
        <path
            android:pathData="M3,7h10v7H3zM5.5,7V5a2.5,2.5 0,0 1,5 0v2"
            android:strokeWidth="1.6"
            android:strokeColor="@color/mdm_alert_ink"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
