<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button: ink fill, 10dp corners. 40dp visible inside a 48dp touch target. With the focus ring on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset
            android:insetTop="4dp"
            android:insetBottom="4dp">
            <ripple android:color="@color/mdm_ripple_on_ink">
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="@dimen/mdm_radius_sm" />
                        <solid android:color="@color/mdm_btn_filled_bg" />
                    </shape>
                </item>
            </ripple>
        </inset>
    </item>
    <item android:drawable="@drawable/mdm_focus_ring_inner" />
</layer-list>
