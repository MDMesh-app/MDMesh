<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: surface + 1dp border-strong. With the focus ring on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset
            android:insetTop="4dp"
            android:insetBottom="4dp">
            <ripple android:color="@color/mdm_ripple">
                <item>
                    <shape android:shape="rectangle">
                        <corners android:radius="@dimen/mdm_radius_sm" />
                        <solid android:color="@color/mdm_surface" />
                        <stroke android:width="1dp" android:color="@color/mdm_border_strong" />
                    </shape>
                </item>
            </ripple>
        </inset>
    </item>
    <item android:drawable="@drawable/mdm_focus_ring" />
</layer-list>
