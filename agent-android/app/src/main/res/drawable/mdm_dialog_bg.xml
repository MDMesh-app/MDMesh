<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog window: surface, 16dp corners, 1dp border (keeps the edge visible on the dark scrim). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="@dimen/mdm_dialog_inset">
    <shape android:shape="rectangle">
        <corners android:radius="@dimen/mdm_radius_lg" />
        <solid android:color="@color/mdm_surface" />
        <stroke android:width="1dp" android:color="@color/mdm_border" />
    </shape>
</inset>
