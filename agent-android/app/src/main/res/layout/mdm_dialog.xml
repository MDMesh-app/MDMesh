<?xml version="1.0" encoding="utf-8"?>
<!--
    The one dialog layout (MdmDialog): v2 Modal on M3 dialog metrics. Our own layout instead of AppCompat's alert
    template, whose title row (32dp icon box, 18dp top), 16sp message and 48dp minimum content height don't line
    up with v2 and differ by API level. Everything starts on one left edge, 24dp in: icon or title, message,
    the body (exit PIN field), and the buttons end on the same right edge, 24dp in.
    Title, message and body scroll when they don't fit (large font, landscape, keyboard up); the buttons don't.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- wrap_content + weight: as tall as its content, and it gives way first when the window is too short. -->
    <ScrollView
        android:id="@+id/mdm_dialog_scroll"
        tools:ignore="InefficientWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/mdm_dialog_padding"
            android:paddingTop="@dimen/mdm_dialog_padding"
            android:paddingEnd="@dimen/mdm_dialog_padding">

            <!-- Not a compound drawable: those centre on the whole text block, not on the title's first line. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                tools:ignore="UseCompoundDrawables">

                <!-- Centred on the title's first line in code (MdmDialog.alignIcon), so it holds for any font. -->
                <ImageView
                    android:id="@+id/mdm_dialog_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/mdm_dialog_icon_gap"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    tools:src="@drawable/ic_v2_lock"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/mdm_dialog_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.MdmAgent.TitleLarge"
                    tools:text="Exit locked" />
            </LinearLayout>

            <TextView
                android:id="@+id/mdm_dialog_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/mdm_dialog_title_gap"
                android:lineSpacingExtra="@dimen/mdm_body_line_extra"
                android:textAppearance="@style/TextAppearance.MdmAgent.BodyMedium"
                tools:text="Too many wrong PINs. Try again in 5 minutes." />

            <FrameLayout
                android:id="@+id/mdm_dialog_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Buttons end on the content's right edge. Paddings are 4dp short of 24dp: the button backgrounds carry a
         4dp inset (40dp drawn in a 48dp touch target). Stacks when the labels don't fit side by side. -->
    <com.mdmesh.agent.ui.DialogButtonBar
        android:id="@+id/mdm_dialog_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/mdm_dialog_padding"
        android:paddingTop="@dimen/mdm_dialog_bar_padding_v"
        android:paddingEnd="@dimen/mdm_dialog_padding"
        android:paddingBottom="@dimen/mdm_dialog_bar_padding_v">

        <Button
            android:id="@+id/mdm_dialog_cancel"
            style="@style/Widget.MdmAgent.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Cancel"
            tools:visibility="visible" />

        <Button
            android:id="@+id/mdm_dialog_confirm"
            style="@style/Widget.MdmAgent.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mdm_dialog_button_gap"
            tools:text="OK" />

        <Button
            android:id="@+id/mdm_dialog_confirm_danger"
            style="@style/Widget.MdmAgent.Button.Danger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mdm_dialog_button_gap"
            android:visibility="gone" />
    </com.mdmesh.agent.ui.DialogButtonBar>
</LinearLayout>
