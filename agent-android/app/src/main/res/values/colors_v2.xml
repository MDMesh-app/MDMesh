<?xml version="1.0" encoding="utf-8"?>
<!--
    v2 colour tokens, light. Same values as the console's web/src/tokens.css (.v2); dark is in values-night/.
    Every name here must exist in values-night/colors_v2.xml too (ThemeResourcesTest checks it). The whole
    token set is kept even where no screen uses a colour yet (callout tones arrive with the screen redesigns).
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="UnusedResources">
    <color name="mdm_app">#F6F7F9</color>              <!-- -app: screen background -->
    <color name="mdm_surface">#FFFFFF</color>          <!-- -surface: cards, dialogs, inputs -->
    <color name="mdm_surface_2">#F1F2F5</color>        <!-- -surface-2 -->
    <color name="mdm_border">#E7E9EE</color>           <!-- -border: card/dialog border, dividers -->
    <color name="mdm_border_strong">#D6DAE1</color>    <!-- -border-strong: secondary button outline -->
    <color name="mdm_input_border">#878F9C</color>     <!-- -input-border: text field outline (3:1) -->
    <color name="mdm_ink">#15181D</color>              <!-- -ink: primary button, focus, cursor -->
    <color name="mdm_on_ink">#FFFFFF</color>           <!-- -on-ink -->
    <color name="mdm_text">#1B2230</color>             <!-- -text -->
    <color name="mdm_text_2">#384152</color>           <!-- -text-2: labels, dialog message -->
    <color name="mdm_secondary">#586073</color>        <!-- -secondary: help, meta, hint -->
    <color name="mdm_disabled_bg">#E7E9EE</color>      <!-- -disabled-bg -->
    <color name="mdm_disabled_ink">#586073</color>     <!-- -disabled-ink -->
    <color name="mdm_ok_ink">#0E7A47</color>
    <color name="mdm_ok_soft">#E6F6EE</color>
    <color name="mdm_ok_wash">#F7FCF9</color>         <!-- -ok-wash: ok callout fill -->
    <color name="mdm_ok_line">#BFE8D2</color>
    <color name="mdm_warn_ink">#8F5410</color>
    <color name="mdm_warn_soft">#FCF1E3</color>
    <color name="mdm_warn_line">#F1D3AD</color>
    <color name="mdm_alert_ink">#A92F2F</color>
    <color name="mdm_alert_soft">#FBE9E9</color>
    <color name="mdm_alert_line">#F0D4D4</color>
    <!-- Touch feedback: ink at 12% on surfaces, on-ink at 24% on the filled ink button. -->
    <color name="mdm_ripple">#1F15181D</color>
    <color name="mdm_ripple_on_ink">#3DFFFFFF</color>
    <!-- Text selection highlight: ink at 25%. -->
    <color name="mdm_selection">#4015181D</color>
</resources>
