<?xml version="1.0" encoding="utf-8"?>
<!-- Widget styles (v2 Button, Field, Modal pieces), hand-built on AppCompat. -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Filled ink button (v2 primary). -->
    <style name="Widget.MdmAgent.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/mdm_btn_filled</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.MdmAgent.LabelLarge</item>
        <item name="android:textColor">@color/mdm_btn_filled_label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/mdm_touch_target</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Secondary: surface + border-strong, ink label. -->
    <style name="Widget.MdmAgent.Button.Outlined" tools:ignore="UnusedResources">
        <item name="android:background">@drawable/mdm_btn_outlined</item>
        <item name="android:textColor">@color/mdm_btn_label</item>
    </style>

    <!-- Danger: surface + alert line, alert-ink label ("Lock anyway"). -->
    <style name="Widget.MdmAgent.Button.Danger">
        <item name="android:background">@drawable/mdm_btn_danger</item>
        <item name="android:textColor">@color/mdm_btn_danger_label</item>
    </style>

    <!-- Ghost: no fill, ink label. -->
    <style name="Widget.MdmAgent.Button.Text">
        <item name="android:background">@drawable/mdm_btn_text</item>
        <item name="android:textColor">@color/mdm_btn_label</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- Text field (v2 Field): 10dp corners, input border, 2dp ink focus ring, 48dp tall. -->
    <style name="Widget.MdmAgent.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/mdm_field_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textAppearance">@style/TextAppearance.MdmAgent.BodyLarge</item>
        <item name="android:textColor">@color/mdm_text</item>
        <item name="android:textColorHint">@color/mdm_secondary</item>
        <item name="android:minHeight">@dimen/mdm_touch_target</item>
        <item name="android:paddingStart">@dimen/mdm_field_padding_h</item>
        <item name="android:paddingEnd">@dimen/mdm_field_padding_h</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
</resources>
