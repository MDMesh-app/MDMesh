<?xml version="1.0" encoding="utf-8"?>
<!--
    v2 type scale as TextAppearances, all in sp so they follow the system font size. System font (D3);
    "sans-serif-medium" is the platform's 500 weight. Unused ones are for the screen redesigns (P4/P5);
    release builds shrink away whatever stays unused.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="TextAppearance.MdmAgent.HeadlineSmall" parent="TextAppearance.AppCompat" tools:ignore="UnusedResources">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/mdm_text</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>

    <style name="TextAppearance.MdmAgent.TitleLarge" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/mdm_text</item>
    </style>

    <style name="TextAppearance.MdmAgent.TitleMedium" parent="TextAppearance.AppCompat" tools:ignore="UnusedResources">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/mdm_text</item>
    </style>

    <style name="TextAppearance.MdmAgent.BodyLarge" parent="TextAppearance.AppCompat">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/mdm_text</item>
    </style>

    <style name="TextAppearance.MdmAgent.BodyMedium" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/mdm_text_2</item>
    </style>

    <style name="TextAppearance.MdmAgent.BodySmall" parent="TextAppearance.AppCompat">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/mdm_secondary</item>
    </style>

    <style name="TextAppearance.MdmAgent.LabelLarge" parent="TextAppearance.AppCompat.Widget.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Section label ("DEVICE ID"): 12/600 caps, wide tracking, secondary. -->
    <style name="TextAppearance.MdmAgent.Eyebrow" parent="TextAppearance.AppCompat" tools:ignore="UnusedResources">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/mdm_secondary</item>
    </style>

    <style name="TextAppearance.MdmAgent.Mono" parent="TextAppearance.AppCompat" tools:ignore="UnusedResources">
        <item name="android:textSize">14sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textColor">@color/mdm_text</item>
    </style>

</resources>
