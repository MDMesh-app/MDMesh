# Edge for MDMesh. Serves the SPA and reverse-proxies the API/files/wake-socket to the server.
# SITE_ADDRESS is set by the setup wizard:
#   own-domain  → "mdm.example.com" (Caddy auto-provisions + renews a Let's Encrypt cert)
#   cloudflare  → ":80" (Cloudflare terminates TLS; cloudflared connects to this internally)
{
	email "{$ACME_EMAIL}"
	# Which direct peers may set X-Forwarded-For (so the server records a device's real public IP).
	# Default: loopback only — no Docker peer is loopback, so behaviour is effectively unchanged for the
	# own-domain and Cloudflare modes. The reverse-proxy overlay trusts only configured proxy peers.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32 ::1/128}
	}
}

{$SITE_ADDRESS} {
	import /etc/caddy/Caddyfile.routes
}
