{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdm.local/proto/v1/agent-checkin-request.schema.json",
  "title": "AgentCheckInRequest",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocolVersion", "deviceId", "capabilities"],
  "properties": {
    "protocolVersion": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "deviceId": { "type": "string" },
    "capabilities": { "$ref": "capability-matrix.schema.json#/properties/capabilities" },
    "results": {
      "type": "array",
      "description": "Acks for previously-delivered commands.",
      "items": { "$ref": "command-result.schema.json" }
    },
    "state": { "type": "object", "additionalProperties": true, "description": "Compact device-state snapshot (AgentDeviceStateDto): battery, charging, locked, kioskActive, androidRelease, lastBootAt, and optional fields such as agentVersion and powerMode." },
    "telemetry": { "type": "object", "additionalProperties": true, "description": "Full device census (TelemetrySnapshot); supersedes state." },
    "events": { "type": "array", "items": { "type": "object", "additionalProperties": true }, "description": "Buffered lifecycle events (TelemetryEventDto) flushed on this check-in." },
    "hardwareId": { "type": "string", "description": "The same stable, permission-free device id as on enroll, so an enrolled device can backfill it." }
  }
}
