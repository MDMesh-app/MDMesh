<!--
  The server's only log4j config: everything goes to stdout, at INFO. Docker keeps it in the container log
  (docker compose logs server), native installs in the journal (journalctl -u mdmesh-server). There is no log file and
  no external config: log4j reads this file when the first logger is created, before any web.xml listener runs. Audit
  events are the lines of the "AuditLogger" logger. docs/OPERATIONS.md ("Server logs") has the temporary-DEBUG override.
  LoggingConfigTest pins these levels.
-->
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">
<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/" debug="false">

    <appender name="stdout" class="org.apache.log4j.ConsoleAppender">
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="%d{yyyy-MM-dd HH:mm:ss} [%p] %-10c : %m%n"/>
        </layout>
    </appender>

    <!-- Audit events (plugins/audit AuditFilter), through the root's stdout appender. Pinned at INFO whatever the root level is. -->
    <logger name="AuditLogger">
        <level value="INFO"/>
    </logger>

    <!-- Suppress 'Stealing link for clientId ...' warnings -->
    <logger name="org.apache.activemq.broker.region.RegionBroker">
        <level value="ERROR"/>
    </logger>

    <root>
        <level value="INFO"/>
        <appender-ref ref="stdout"/>
    </root>

</log4j:configuration>