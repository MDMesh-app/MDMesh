{
  "name": "mdmesh-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MDMesh — admin console for the device fleet",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "vite",
    "build": "node check-v03-files.ts && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint:css": "stylelint \"src/**/*.css\"",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.test.*\" --ignore \"src/**/*.d.ts\" --out-file src/i18n/locales/en.json --throws",
    "i18n:pseudo": "formatjs compile src/i18n/locales/en.json --ast --pseudo-locale en-XA --out-file src/i18n/pseudo/en-XA.json",
    "i18n:baseline": "vitest run src/i18n/literals.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "12.1.7",
    "react-router": "^8.5.1",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@formatjs/cli": "6.18.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/spark-md5": "^3.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "4.14.0",
    "jsdom": "^31.0.1",
    "stylelint": "^18.0.0",
    "stylelint-declaration-strict-value": "^1.13.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
